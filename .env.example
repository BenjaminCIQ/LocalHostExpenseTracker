# Copy to .env and set values. Never commit .env or real secrets.

# Database (optional: use SQLCipher by setting EXPENSE_TRACKER_DATABASE_PASSPHRASE)
EXPENSE_TRACKER_DATABASE_URL=sqlite:///./data/expense_tracker.db

# Required in production: set a strong random value
EXPENSE_TRACKER_AUTH_TOKEN_PEPPER=change-me-in-production

# Optional: enable SQLite encryption at rest (key from env only)
# EXPENSE_TRACKER_DATABASE_PASSPHRASE=

# Production behind HTTPS: set to true
# EXPENSE_TRACKER_AUTH_COOKIE_SECURE=false

# Production: set your front-end origin(s), comma-separated
# EXPENSE_TRACKER_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: fail startup if pepper unchanged (set to production)
# EXPENSE_TRACKER_ENV=development

# Optional: serve built frontend from backend (e.g. Docker); path to frontend dist dir
# EXPENSE_TRACKER_STATIC_DIR=
